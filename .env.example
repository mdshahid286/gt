# Which provider to use: "gemini" or "groq"
LLM_PROVIDER=gemini

# Optional: override the default model for the chosen provider.
# Defaults are set in agents/base_agent.py -- leave blank to use them.
LLM_MODEL=

# Fill in whichever provider you're using (only one is required)
GOOGLE_API_KEY=your-gemini-api-key-here
GROQ_API_KEY=your-groq-api-key-here
